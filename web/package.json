{
  "name": "state-of-soroban-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "cd .. && uv run state-of-soroban openapi",
    "types": "pnpm openapi && openapi-typescript openapi.json -o src/lib/api-schema.ts --root-types --root-types-no-schema-prefix",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "cmdk": "^1.1.1",
    "d3-force-3d": "^3.0.6",
    "lucide-react": "^1.77.0",
    "moment": "^2.31.0",
    "motion": "^14.14.0",
    "openapi-fetch": "^0.17.0",
    "postprocessing": "^6.39.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "storybook": "^10.6.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
