# One or more fine-grained, public read-only github tokens, comma separated.
# Tokens from different accounts each get their own rate limit, so put both keys
# here as `ghp_first,ghp_second` and the indexer rotates between them.
GITHUB_TOKENS=

# The postgres the indexer writes to. The default matches docker compose.
DATABASE_URL=postgresql://soroban:soroban@localhost:5443/soroban
# Host port the database is published on.
DB_PORT=5443

# Mainnet soroban rpc used to read deployed contracts. Any public endpoint works.
# MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
# Where the indexer keeps its shallow clones while it reads them.
# CLONE_DIR=
# The yaml that defines the workflow, default workflow/workflow.yaml.
# WORKFLOW_FILE=
